{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://github.com/starfield17/rhost/schemas/result-v1.schema.json",
  "title": "rhost result envelope v1",
  "description": "The single JSON document emitted by an agent-facing rhost command when --json is set.",
  "type": "object",
  "required": ["schema_version", "operation", "ok", "data", "error"],
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "const": 1,
      "description": "Envelope schema version."
    },
    "operation": {
      "type": "string",
      "description": "Command that produced this document, e.g. exec, doctor, hosts, version."
    },
    "ok": {
      "type": "boolean",
      "description": "True when the adapter operation completed as designed. The remote command may still have a non-zero exit_code."
    },
    "host": {
      "type": "string",
      "description": "Target host, when applicable."
    },
    "data": {
      "description": "Operation-specific payload; null on failure unless partial data is useful."
    },
    "error": {
      "oneOf": [
        { "type": "null" },
        {
          "type": "object",
          "required": ["code", "message", "retryable"],
          "additionalProperties": false,
          "properties": {
            "code": {
              "type": "string",
              "enum": [
                "CONFIG_INVALID",
                "FILE_CONFLICT",
                "FILE_NOT_FOUND",
                "FILE_TOO_LARGE",
                "HOST_KEY_FAILED",
                "HOST_UNKNOWN",
                "INTERNAL",
                "INVALID_PATCH",
                "INVALID_TARGET",
                "INVALID_TEXT",
                "JOB_NOT_FOUND",
                "JOB_STATE_UNKNOWN",
                "OUTPUT_WRITE_FAILED",
                "REMOTE_COMMAND_CANCELLED",
                "REMOTE_COMMAND_TIMEOUT",
                "REMOTE_DEPENDENCY_MISSING",
                "SESSION_BUSY",
                "SESSION_NOT_FOUND",
                "SESSION_UNHEALTHY",
                "SSH_AUTH_FAILED",
                "SSH_UNREACHABLE",
                "SYNC_REJECTED",
                "TRANSFER_FAILED",
                "TUNNEL_FAILED",
                "TUNNEL_NOT_FOUND",
                "UNSUPPORTED_REMOTE_OS",
                "USAGE_ERROR"
              ]
            },
            "message": { "type": "string" },
            "retryable": { "type": "boolean" }
          }
        }
      ]
    }
  }
}
